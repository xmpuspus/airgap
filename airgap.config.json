  "locale": {
    "currency": "PHP",
    "language": "en",
    "region": "PH"
  },
  "privacy": {
    "dataRetentionDays": 30,
    "allowExport": true,
    "allowDeleteData": true
  },
  "i18n": {
    "strings": {}
  },
  "analytics": {
    "enabled": false
  },
  "auth": {
    "enabled": false
  },
  "llm": {
    "mode": "demo",
    "cacheByKbVersion": true,
    "supportDomain": "telco",
    "providers": [
      {
        "id": "apple-foundation-models",
        "enabled": true,
        "priority": 0,
        "platform": "ios",
        "minimumOsVersion": "26.0",
        "locales": ["en", "en-US"],
        "allowModelDownload": false,
        "allowCloudFallback": false
      },
      {
        "id": "android-aicore",
        "enabled": true,
        "priority": 0,
        "platform": "android",
        "minimumOsVersion": "26",
        "locales": ["en", "en-US"],
        "allowModelDownload": true,
        "allowCloudFallback": false
      },
      {
        "id": "llama-rn",
        "enabled": true,
        "priority": 10,
        "platform": "all",
        "allowModelDownload": true,
        "allowCloudFallback": false
      },
      {
        "id": "cloud",
        "enabled": false,
        "priority": 20,
        "platform": "all",
        "allowCloudFallback": true
      },
      {
        "id": "demo",
        "enabled": true,
        "priority": 30,
        "platform": "all"
      }
    ],
    "cloud": {
      "enabled": false,
      "maxTokens": 512,
      "temperature": 0.3
    }
  },
  "safety": {
    "enabled": true,
    "confidenceThreshold": 0,
    "topicBlocklist": [
      "not_medical_advice:diagnose me",
      "not_medical_advice:prescribe",
      "not_financial_advice:should I invest",
      "not_financial_advice:financial advice",
      "not_legal_advice:sue",
      "not_legal_advice:legal advice",
      "blocked_topic:political",
      "blocked_topic:self harm"
    ],
    "groundingRules": {
      "requireCitations": false,
      "forbidUnsourcedAmounts": true,
      "forbidUnsourcedDates": true
    },
    "refusalTemplates": {
      "low_confidence": "I don't have reliable information on that. Please call {{hotline}} ({{hotlineLabel}}) and a support specialist can help.",
      "ungrounded_answer": "I can't confirm the specifics on that right now. For accurate details, please call {{hotline}}."
    }
  },
