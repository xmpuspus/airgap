{
  "name": "airgap",
  "version": "0.2.0",
  "private": true,
  "author": "Xavier Puspus (https://github.com/xmpuspus)",
  "repository": "https://github.com/xmpuspus/airgap",
  "license": "MIT",
  "keywords": [
    "air-gapped",
    "offline-first",
    "customer-support",
    "react-native",
    "gemma",
    "llm",
    "rag",
    "white-label",
    "enterprise"
  ],
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "format:check": "node scripts/check-format.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "start": "react-native start",
    "test": "jest",
    "setup": "bash scripts/setup.sh",
    "generate-manifest": "node scripts/generate-manifest.js",
    "kb:validate": "node scripts/kb-validate.js",
    "kb:import": "node scripts/kb-import.js",
    "kb:studio": "node scripts/kb-studio.js",
    "web:build": "node web/data/build.mjs",
    "web:serve": "node web/data/build.mjs && python3 -m http.server -d web 8080",
    "server:test": "node --test __tests__/server.test.mjs",
    "signing:test": "node --test __tests__/android-signing.test.mjs __tests__/ios-keychain-entitlements.test.mjs",
    "journeys": "node __tests__/run-journeys.mjs && node __tests__/run-multi-turn.mjs && node __tests__/run-industry-tests.mjs",
    "cli:pack:test": "npm run build-template --workspace create-airgap-bot && npm test --workspace create-airgap-bot -- --runInBand && npm pack --workspace create-airgap-bot --dry-run",
    "security:direct": "node scripts/check-direct-advisories.mjs",
    "recordings:rebuild": "node scripts/rebuild-recording-gifs.mjs",
    "recordings:validate": "node scripts/validate-recordings.mjs",
    "providers:scenarios": "node scripts/validate-provider-evidence.mjs --list",
    "providers:validate": "node scripts/validate-provider-evidence.mjs",
    "providers:swift:test": "swiftc ios/Airgap/ProviderHarness.swift scripts/provider-harness-swift-tests/main.swift -o \"${TMPDIR:-/tmp}/airgap-provider-harness-tests\" && \"${TMPDIR:-/tmp}/airgap-provider-harness-tests\" validation/provider-scenarios.json",
    "providers:apple:probe": "node scripts/evaluate-apple-host.mjs --probe",
    "providers:apple:evaluate": "node scripts/evaluate-apple-host.mjs --require-available",
    "providers:scenario": "node scripts/run-provider-scenario.mjs",
    "providers:device:preflight": "node scripts/provider-device-preflight.mjs",
    "providers:android:prepare-model": "node scripts/prepare-android-model.mjs"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/new-app-screen": "0.84.1",
    "@react-navigation/native": "7.2.2",
    "@react-navigation/native-stack": "7.14.10",
    "llama.rn": "0.12.0-rc.3",
    "minisearch": "7.2.0",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-fs": "2.20.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "10.0.0",
    "react-native-mmkv": "4.3.0",
    "react-native-nitro-modules": "^0.35.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.24.0",
    "tweetnacl": "1.0.3",
    "uuid": "13.0.2"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/runtime": "8.0.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "@types/uuid": "10.0.0",
    "eslint": "10.8.1",
    "jest": "30.4.2",
    "node-llama-cpp": "3.20.0",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "tar": "7.5.22"
  }
}
